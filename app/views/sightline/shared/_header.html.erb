<%# The top of every Sightline page: the app's name, the page's title, a line about it, the page's icon if the app set
    one, and, unless turned off, the navigation. %>
<% content_for :title, title %>
<%= stylesheet_link_tag "sightline/application" %>
<header class="sl-header">
  <div>
    <span class="sl-eyebrow"><%= Sightline.config.title %></span>
    <h1 class="sl-title"><%= title %></h1>
    <% if local_assigns[:intro].present? %><p class="sl-intro"><%= intro %></p><% end %>
  </div>
  <%= local_assigns[:actions] %>
  <% if (icon = Sightline.config.icons[title]).present? %><span class="sl-icon" aria-hidden="true"><%= icon %></span><% end %>
</header>
<% if Sightline.config.navigation %>
<nav class="sl-nav" aria-label="<%= Sightline.config.title %> sections">
  <% sightline_navigation.each do |item| %>
    <%= link_to item.label, item.url, class: [ "sl-nav-link", ("sl-current" if item.current) ], aria: { current: ("page" if item.current) } %>
  <% end %>
</nav>
<% end %>
