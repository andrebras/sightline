<% most = [ values.map(&:last).max || 0, 1 ].max %>
<%= tag.ol class: "sl-panel sl-bars", style: "--sl-bar-count: #{values.size}", aria: { label: label } do %>
  <% values.each do |day, value| %>
    <li>
      <strong><%= sl_format(value) %></strong>
      <span class="sl-bar" style="height: <%= (100.0 * value / most).round %>%"></span>
      <small><%= day.strftime("%a %-d") %></small>
    </li>
  <% end %>
<% end %>
